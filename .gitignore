# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Generated from registry.schema.json — regenerated by `npm install`
# (postinstall) or `npm run gen:schema-types`, never hand-edited or committed.
src/generated/

# Env files — this is a static, backend-less client (no secrets are meant to
# exist here at all), but ignore them defensively in case a contributor's
# local tooling creates one.
.env
.env.*
!.env.example

# Test artifacts
playwright-report/
test-results/
coverage/

# Editor/OS noise
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Logs
npm-debug.log*

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/maslovsa/canvas-wallet/raw/main/registry.schema.json",
  "title": "Token UI Studio Registry",
  "description": "Canonical schema for a multi-chain token registry with Server-Driven UI (SDUI) card customization. Any unknown widget.type or action.type MUST be ignored at render time, never rejected — but at authoring/CI time, unknown types fail schema validation (see widget/action oneOf below).",
  "type": "object",
  "required": ["schemaVersion", "networks"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "description": "Version of this schema the registry was authored against, semver-shaped (e.g. \"1.0.0\"). Intentionally NOT constrained to a fixed enum here — a future schema revision must remain syntactically valid so a client can read the field and make its own compatibility decision (see src/registry-client/schema-version-gate.ts). A client that doesn't recognize this version MUST refuse to render/edit rather than guess.",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "networks": {
      "type": "array",
      "items": { "$ref": "#/definitions/network" }
    }
  },
  "definitions": {
    "network": {
      "type": "object",
      "required": ["name", "tokens"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "tokens": {
          "type": "array",
          "items": { "$ref": "#/definitions/token" }
        }
      }
    },
    "token": {
      "type": "object",
      "required": ["name", "symbol", "type", "id", "decimals", "status"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string", "minLength": 1, "maxLength": 20 },
        "type": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1, "description": "Contract/token address." },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 255 },
        "logo": {
          "type": "string",
          "format": "uri",
          "description": "Token logo image. Subject to the same domain allowlist as widget icons (src/icon/domain-allowlist.ts, enforced client-side AND by scripts/validate-fixtures.ts in CI) — not free-form."
        },
        "website": { "type": "string", "format": "uri" },
        "description": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["active", "paused", "deprecated"] },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "url"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "format": "uri" }
            }
          }
        },
        "explorer": { "type": "string", "format": "uri" },
        "issuer": { "$ref": "#/definitions/issuer" },
        "ui": { "$ref": "#/definitions/ui" },
        "actions": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/action" }
        },
        "widgets": {
          "type": "array",
          "items": { "$ref": "#/definitions/widget" }
        }
      }
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "description": "Who issues/backs this token — mainly relevant for stablecoins. Optional and separate from `description` because the client renders it structurally (name + a country badge in the card header, see src/ui/phone-frame.ts).",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "ISO 3166-1 alpha-2 code of the issuer's jurisdiction (e.g. \"US\", \"CH\"). Omit entirely for a decentralized protocol/foundation with no single jurisdiction (e.g. Ethereum, Bitcoin) — the client shows a globe/worldwide icon when this is absent, and never guesses a country from the issuer name."
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theme": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "primaryColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "badgeText": { "type": "string", "maxLength": 40 }
          }
        },
        "background": {
          "description": "solid/gradient are free-form colors. image was originally excluded entirely (tracking/phishing vector: an arbitrary external image loads on every card view, and could impersonate a trusted brand's skin) — re-scoped rather than dropped: image.url is subject to the SAME domain allowlist as token/widget icons (src/icon/domain-allowlist.ts), enforced client-side (src/icon/icon-loader.ts) and by scripts/validate-fixtures.ts in CI. A free-form image_pattern (arbitrary domain, tiled) remains excluded — see fixtures/adversarial/image-pattern-excluded.json.",
          "oneOf": [
            { "$ref": "#/definitions/backgroundSolid" },
            { "$ref": "#/definitions/backgroundGradient" },
            { "$ref": "#/definitions/backgroundImage" }
          ]
        }
      }
    },
    "backgroundSolid": {
      "type": "object",
      "required": ["type", "colors"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "solid" },
        "colors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
        }
      }
    },
    "backgroundGradient": {
      "type": "object",
      "required": ["type", "colors"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "gradient" },
        "colors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
        },
        "angle": { "type": "number", "minimum": 0, "maximum": 360 }
      }
    },
    "backgroundImage": {
      "type": "object",
      "required": ["type", "url"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "image" },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Domain-allowlisted (src/icon/domain-allowlist.ts), same as token.logo and widget icons. Rendered cover-fit behind the card content via src/icon/icon-loader.ts (size-limited, same as any other icon fetch)."
        },
        "overlayColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Shown immediately while the image loads, and as the fallback if the URL is off-allowlist or the fetch fails — a background image must never silently disappear into a broken/blank card."
        }
      }
    },
    "action": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        { "$ref": "#/definitions/actionExternalUrl" },
        { "$ref": "#/definitions/actionDeeplink" },
        { "$ref": "#/definitions/actionWalletConnect" }
      ]
    },
    "actionExternalUrl": {
      "type": "object",
      "required": ["type", "url"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "external_url" },
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "May contain {symbol}, {id}, {user_address} — the ONLY allowed substitution variables. Client must URL-encode each substituted value."
        },
        "openIn": { "type": "string", "enum": ["in_app_browser", "external_browser"] }
      }
    },
    "actionDeeplink": {
      "type": "object",
      "required": ["type", "url"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "deeplink" },
        "url": { "type": "string", "minLength": 1 }
      }
    },
    "actionWalletConnect": {
      "type": "object",
      "required": ["type", "dappUrl"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "wallet_connect" },
        "dappUrl": { "type": "string", "format": "uri" }
      }
    },
    "widget": {
      "oneOf": [
        { "$ref": "#/definitions/widgetBanner" },
        { "$ref": "#/definitions/widgetActionGroup" },
        { "$ref": "#/definitions/widgetKeyValue" },
        { "$ref": "#/definitions/widgetNotice" },
        { "$ref": "#/definitions/widgetPriceChart" },
        { "$ref": "#/definitions/widgetHistory" }
      ]
    },
    "widgetBanner": {
      "type": "object",
      "required": ["type", "title", "action"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "banner" },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 300 },
        "icon": { "type": "string", "format": "uri" },
        "action": { "type": "string", "minLength": 1, "description": "Key into the token's actions map." }
      }
    },
    "widgetActionGroup": {
      "type": "object",
      "required": ["type", "items"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "action_group" },
        "title": { "type": "string", "maxLength": 80 },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "action"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 40 },
              "icon": { "type": "string" },
              "action": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "widgetKeyValue": {
      "type": "object",
      "required": ["type", "items"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "key_value" },
        "title": { "type": "string", "maxLength": 80 },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 40 },
              "value": { "type": "string", "minLength": 1, "maxLength": 40 }
            }
          }
        }
      }
    },
    "widgetNotice": {
      "type": "object",
      "required": ["type", "message"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "notice" },
        "message": { "type": "string", "minLength": 1, "maxLength": 200 },
        "severity": { "type": "string", "enum": ["info", "warning"] }
      }
    },
    "widgetPriceChart": {
      "type": "object",
      "required": ["type", "coingeckoId"],
      "additionalProperties": false,
      "description": "The only widget that performs a live network call: fetches public, unauthenticated historical price data from api.coingecko.com (no API key — none needed, none shipped; see CONTRIBUTING.md). Falls back to a clearly-labeled generated placeholder sparkline if the fetch fails (offline, rate-limited, unrecognized id).",
      "properties": {
        "type": { "const": "price_chart" },
        "coingeckoId": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "minLength": 1,
          "maxLength": 64,
          "description": "CoinGecko coin id, e.g. \"tron\", \"ethereum\" (NOT the ticker symbol). Constrained to lowercase/digits/hyphen so it can only ever be a path segment, never a URL/query injection."
        },
        "title": { "type": "string", "maxLength": 80 },
        "days": {
          "type": "integer",
          "enum": [1, 7, 30, 90, 365],
          "description": "Range of price history to request, in days. Defaults to 1 (24h) if omitted."
        }
      }
    },
    "widgetHistory": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "description": "Illustrative only: renders a small, client-generated set of fake recent-activity rows (received/sent, each capped at $100 equivalent). No wallet, backend, or real transaction data is ever involved — see src/widgets/history.ts.",
      "properties": {
        "type": { "const": "history" },
        "title": { "type": "string", "maxLength": 80 }
      }
    }
  }
}
